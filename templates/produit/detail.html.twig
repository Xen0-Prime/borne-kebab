{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }} — Borne Kebab{% endblock %}

{% block stylesheets %}
<style>
    .produit-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        align-items: start;
    }
    @media (max-width: 700px) {
        .produit-layout { grid-template-columns: 1fr; }
    }
    .produit-image img {
        width: 100%; border-radius: 12px;
        max-height: 320px; object-fit: cover;
    }
    .produit-image .placeholder {
        width: 100%; height: 280px;
        background: #fce4e4; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 80px;
    }
    .produit-info h2 { font-size: 26px; margin-bottom: 8px; }
    .produit-desc { color: #555; font-size: 15px; margin-bottom: 16px; line-height: 1.6; }
    .prix-base { font-size: 28px; font-weight: bold; color: #c0392b; margin-bottom: 24px; }

    /* Options */
    .options-section { background: white; border-radius: 10px; padding: 20px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.07); }
    .options-section h3 { font-size: 16px; margin-bottom: 14px; padding-bottom: 8px; border-bottom: 2px solid #f0f0f0; color: #333; }
    .option-item {
        display: flex; align-items: center; justify-content: space-between;
        padding: 10px 0; border-bottom: 1px solid #f5f5f5;
    }
    .option-item:last-child { border-bottom: none; }
    .option-label { display: flex; align-items: center; gap: 10px; cursor: pointer; flex: 1; }
    .option-label input[type="checkbox"] { width: 20px; height: 20px; accent-color: #c0392b; cursor: pointer; }
    .option-nom { font-size: 15px; }
    .option-prix-gratuit { font-size: 13px; color: #27ae60; font-weight: bold; }
    .option-prix-payant  { font-size: 13px; color: #e67e22; font-weight: bold; }

    /* Prix total dynamique */
    .prix-total-block {
        background: #c0392b; color: white;
        border-radius: 10px; padding: 16px 20px;
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 16px;
    }
    .prix-total-label { font-size: 16px; }
    .prix-total-value { font-size: 28px; font-weight: bold; }
</style>
{% endblock %}

{% block content %}

    {# Fil d'Ariane #}
    <div class="breadcrumb">
        <a href="{{ path('app_carte_index') }}">Accueil</a>
        &rsaquo; <a href="{{ path('app_carte_categorie', {id: produit.categorie.id}) }}">{{ produit.categorie.nom }}</a>
        &rsaquo; {{ produit.nom }}
    </div>

    <div class="produit-layout">

        {# Colonne gauche : image #}
        <div class="produit-image">
            {% if produit.imageUrl %}
                <img src="{{ asset(produit.imageUrl) }}" alt="{{ produit.nom }}">
            {% else %}
                <div class="placeholder">🥙</div>
            {% endif %}
        </div>

        {# Colonne droite : infos + formulaire #}
        <div class="produit-info">
            <h2>{{ produit.nom }}</h2>
            {% if produit.description %}
                <div class="produit-desc">{{ produit.description }}</div>
            {% endif %}
            <div class="prix-base">Prix de base : {{ produit.prix }} €</div>

            {# Formulaire d'ajout au panier #}
            <form action="{{ path('app_panier_ajouter') }}" method="POST" id="form-ajout">
                <input type="hidden" name="produit_id" value="{{ produit.id }}">

                {# Section : ingrédients à retirer #}
                {% if optionsRetrait is not empty %}
                    <div class="options-section">
                        <h3>❌ Retirer des ingrédients</h3>
                        {% for option in optionsRetrait %}
                            <div class="option-item">
                                <label class="option-label">
                                    <input
                                        type="checkbox"
                                        name="options[]"
                                        value="{{ option.id }}"
                                        data-prix="{{ option.prixSupplementaire }}"
                                    >
                                    <span class="option-nom">{{ option.nom }}</span>
                                </label>
                                <span class="option-prix-gratuit">Gratuit</span>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {# Section : suppléments à ajouter #}
                {% if optionsAjout is not empty %}
                    <div class="options-section">
                        <h3>➕ Ajouter des suppléments</h3>
                        {% for option in optionsAjout %}
                            <div class="option-item">
                                <label class="option-label">
                                    <input
                                        type="checkbox"
                                        name="options[]"
                                        value="{{ option.id }}"
                                        data-prix="{{ option.prixSupplementaire }}"
                                    >
                                    <span class="option-nom">{{ option.nom }}</span>
                                </label>
                                {% if option.prixSupplementaire > 0 %}
                                    <span class="option-prix-payant">+ {{ option.prixSupplementaire }} €</span>
                                {% else %}
                                    <span class="option-prix-gratuit">Gratuit</span>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {# Prix total mis à jour en JavaScript #}
                <div class="prix-total-block">
                    <span class="prix-total-label">Prix total</span>
                    <span class="prix-total-value" id="prix-total">{{ produit.prix }} €</span>
                </div>

                <button type="submit" class="btn btn-success" style="width:100%;font-size:17px;padding:14px">
                    🛒 Ajouter au panier
                </button>
            </form>

            <div style="margin-top:14px">
                <a href="{{ path('app_carte_categorie', {id: produit.categorie.id}) }}" class="btn btn-secondary">
                    ← Retour
                </a>
            </div>
        </div>

    </div>

{% endblock %}

{% block javascripts %}
<script>
    // Recalcul du prix total quand l'utilisateur coche/décoche une option
    const prixBase  = {{ produit.prix }};
    const checkboxes = document.querySelectorAll('input[type="checkbox"][data-prix]');
    const affichage  = document.getElementById('prix-total');

    function recalculer() {
        let total = prixBase;
        checkboxes.forEach(cb => {
            if (cb.checked) {
                total += parseFloat(cb.dataset.prix);
            }
        });
        affichage.textContent = total.toFixed(2) + ' €';
    }

    checkboxes.forEach(cb => cb.addEventListener('change', recalculer));
</script>
{% endblock %}
