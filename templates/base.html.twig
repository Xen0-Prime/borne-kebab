<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Borne Kebab{% endblock %}</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            color: #222;
            min-height: 100vh;
        }

        /* ── HEADER ── */
        header {
            background-color: #c0392b;
            color: white;
            padding: 16px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        header h1 {
            font-size: 24px;
            font-weight: bold;
            letter-spacing: 1px;
        }
        .panier-icon {
            background: white;
            color: #c0392b;
            padding: 8px 18px;
            border-radius: 8px;
            font-weight: bold;
            text-decoration: none;
            font-size: 15px;
        }
        .panier-icon:hover { background: #fce4e4; }

        /* ── FLASH MESSAGES ── */
        .flash-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
            padding: 12px 20px;
            margin: 12px 24px 0;
            border-radius: 6px;
        }
        .flash-error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            padding: 12px 20px;
            margin: 12px 24px 0;
            border-radius: 6px;
        }

        /* ── CONTENU PRINCIPAL ── */
        main { padding: 24px; max-width: 1100px; margin: 0 auto; }

        /* ── BOUTON PRINCIPAL ── */
        .btn {
            display: inline-block;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: bold;
            text-decoration: none;
            border: none;
            cursor: pointer;
        }
        .btn-primary   { background: #c0392b; color: white; }
        .btn-primary:hover { background: #a93226; }
        .btn-secondary { background: #555; color: white; }
        .btn-secondary:hover { background: #333; }
        .btn-danger    { background: #e74c3c; color: white; }
        .btn-danger:hover { background: #c0392b; }
        .btn-success   { background: #27ae60; color: white; }
        .btn-success:hover { background: #1e8449; }

        /* ── GRILLE DE CARTES ── */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        .card {
            background: white;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            overflow: hidden;
            text-decoration: none;
            color: inherit;
            transition: transform .15s, box-shadow .15s;
            display: block;
        }
        .card:hover { transform: translateY(-3px); box-shadow: 0 6px 18px rgba(0,0,0,0.12); }
        .card img { width: 100%; height: 160px; object-fit: cover; }
        .card-placeholder {
            width: 100%; height: 160px;
            background: #fce4e4;
            display: flex; align-items: center; justify-content: center;
            font-size: 48px;
        }
        .card-body { padding: 14px; }
        .card-title { font-size: 16px; font-weight: bold; margin-bottom: 6px; }
        .card-desc  { font-size: 13px; color: #666; margin-bottom: 10px; }
        .card-price {
            font-size: 18px; font-weight: bold; color: #c0392b;
        }

        /* ── BREADCRUMB ── */
        .breadcrumb { font-size: 13px; color: #888; margin-bottom: 16px; }
        .breadcrumb a { color: #c0392b; text-decoration: none; }
        .breadcrumb a:hover { text-decoration: underline; }

        /* ── PAGE TITLE ── */
        .page-title { font-size: 22px; font-weight: bold; margin-bottom: 4px; }
        .page-subtitle { font-size: 14px; color: #666; margin-bottom: 20px; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

<header>
    <a href="{{ path('app_carte_index') }}" style="color:white;text-decoration:none">
        <h1>🥙 Borne Kebab</h1>
    </a>
    <a href="{{ path('app_panier_index') }}" class="panier-icon">
        🛒 Mon panier
    </a>
</header>

{# Affichage des messages flash #}
{% for message in app.flashes('success') %}
    <div class="flash-success">{{ message }}</div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="flash-error">{{ message }}</div>
{% endfor %}

<main>
    {% block content %}{% endblock %}
</main>

{% block javascripts %}{% endblock %}
</body>
</html>
