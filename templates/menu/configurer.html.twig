{% extends 'base.html.twig' %}

{% block title %}{{ menu.nom }} — St-Gentleman{% endblock %}

{% block stylesheets %}
<style>
    .menu-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        align-items: start;
    }
    @media (max-width: 700px) {
        .menu-layout { grid-template-columns: 1fr; }
    }
    .menu-image img {
        width: 100%; border-radius: 12px;
        max-height: 320px; object-fit: cover;
    }
    .menu-image .placeholder {
        width: 100%; height: 280px;
        background: #fce4e4; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 80px;
    }
    .menu-info h2 { font-size: 26px; margin-bottom: 8px; }
    .menu-desc { color: #555; font-size: 15px; margin-bottom: 16px; line-height: 1.6; }
    .prix-base { font-size: 28px; font-weight: bold; color: #c0392b; margin-bottom: 24px; }

    /* Composant section */
    .composant-section {
        background: white; border-radius: 10px; padding: 20px;
        margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    }
    .composant-section h3 {
        font-size: 17px; margin-bottom: 14px; padding-bottom: 8px;
        border-bottom: 2px solid #f0f0f0; color: #333;
    }

    /* Sélection du produit dans le composant */
    .produit-choice {
        display: flex; align-items: center; gap: 12px;
        padding: 10px 0; border-bottom: 1px solid #f5f5f5; cursor: pointer;
    }
    .produit-choice:last-of-type { border-bottom: none; }
    .produit-choice input[type="radio"] { width: 18px; height: 18px; accent-color: #c0392b; cursor: pointer; }
    .produit-choice-label { font-size: 15px; font-weight: 500; flex: 1; }
    .produit-choice-price { font-size: 13px; color: #888; }

    /* Options d'un produit (cachées, révélées par JS) */
    .options-block {
        display: none; margin-top: 10px; padding: 12px;
        background: #fafafa; border-radius: 8px; border: 1px solid #eee;
    }
    .options-block.visible { display: block; }
    .option-item {
        display: flex; align-items: center; justify-content: space-between;
        padding: 8px 0; border-bottom: 1px solid #f0f0f0;
    }
    .option-item:last-child { border-bottom: none; }
    .option-label { display: flex; align-items: center; gap: 10px; cursor: pointer; flex: 1; }
    .option-label input[type="checkbox"] { width: 18px; height: 18px; accent-color: #c0392b; cursor: pointer; }
    .option-nom { font-size: 14px; }
    .option-prix-gratuit { font-size: 12px; color: #27ae60; font-weight: bold; }
    .option-prix-payant  { font-size: 12px; color: #e67e22; font-weight: bold; }

    /* Quantité */
    .qty-block {
        display: flex; align-items: center; gap: 12px; margin-bottom: 20px;
    }
    .qty-block label { font-size: 16px; font-weight: bold; }
    .qty-block input[type="number"] {
        width: 70px; padding: 8px; border: 1px solid #ddd;
        border-radius: 6px; text-align: center; font-size: 16px;
    }

    /* Prix total dynamique */
    .prix-total-block {
        background: #c0392b; color: white;
        border-radius: 10px; padding: 16px 20px;
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 16px;
    }
    .prix-total-label { font-size: 16px; }
    .prix-total-value { font-size: 28px; font-weight: bold; }
</style>
{% endblock %}

{% block content %}

    <div class="breadcrumb">
        <a href="{{ path('app_carte_index') }}">Accueil</a>
        &rsaquo; <a href="{{ path('app_menu_index') }}">Menus</a>
        &rsaquo; {{ menu.nom }}
    </div>

    <div class="menu-layout">

        {# Colonne gauche : image #}
        <div class="menu-image">
            {% if menu.imageUrl %}
                <img src="{{ asset(menu.imageUrl) }}" alt="{{ menu.nom }}">
            {% else %}
                <div class="placeholder">🍱</div>
            {% endif %}
        </div>

        {# Colonne droite : infos + formulaire #}
        <div class="menu-info">
            <h2>{{ menu.nom }}</h2>
            {% if menu.description %}
                <div class="menu-desc">{{ menu.description }}</div>
            {% endif %}
            <div class="prix-base">Prix du menu : {{ menu.prix|number_format(2, ',', ' ') }} €</div>

            <form action="{{ path('app_panier_ajouter_menu') }}" method="POST" id="form-menu">
                <input type="hidden" name="menu_id" value="{{ menu.id }}">

                {# Quantité du menu entier #}
                <div class="qty-block">
                    <label for="quantite">Quantité :</label>
                    <input type="number" name="quantite" id="quantite" value="1" min="1" max="99"
                           data-prix="{{ menu.prix }}">
                </div>

                {# Un bloc par composant #}
                {% for composant in menu.composants %}
                    <div class="composant-section">
                        <h3>🍽️ {{ composant.nom }}</h3>

                        {% for produit in composant.categorie.produits|filter(p => p.disponible) %}
                            {# Choix du produit par radio #}
                            <div class="produit-choice">
                                <input
                                    type="radio"
                                    name="composant_{{ composant.id }}_produit"
                                    id="c{{ composant.id }}_p{{ produit.id }}"
                                    value="{{ produit.id }}"
                                    {% if loop.first %}checked{% endif %}
                                    onchange="showOptions({{ composant.id }}, {{ produit.id }})"
                                >
                                <label for="c{{ composant.id }}_p{{ produit.id }}" class="produit-choice-label" style="cursor:pointer">
                                    {{ produit.nom }}
                                </label>
                                <span class="produit-choice-price">{{ produit.prix }} €</span>
                            </div>

                            {# Bloc options pour ce produit (visible si produit sélectionné) #}
                            {% set optionsRetrait = produit.options|filter(o => o.type == 'retrait') %}
                            {% set optionsAjout   = produit.options|filter(o => o.type == 'ajout') %}

                            {% if optionsRetrait is not empty or optionsAjout is not empty %}
                                <div class="options-block {% if loop.first %}visible{% endif %}"
                                     id="options_c{{ composant.id }}_p{{ produit.id }}">

                                    {% if optionsRetrait is not empty %}
                                        <div style="font-size:13px;font-weight:bold;margin-bottom:8px;color:#333">❌ Retirer :</div>
                                        {% for option in optionsRetrait %}
                                            <div class="option-item">
                                                <label class="option-label">
                                                    <input
                                                        type="checkbox"
                                                        name="composant_{{ composant.id }}_options[]"
                                                        value="{{ option.id }}"
                                                        data-prix="{{ option.prixSupplementaire }}"
                                                    >
                                                    <span class="option-nom">{{ option.nom }}</span>
                                                </label>
                                                <span class="option-prix-gratuit">Gratuit</span>
                                            </div>
                                        {% endfor %}
                                    {% endif %}

                                    {% if optionsAjout is not empty %}
                                        <div style="font-size:13px;font-weight:bold;margin:10px 0 8px;color:#333">➕ Ajouter :</div>
                                        {% for option in optionsAjout %}
                                            <div class="option-item">
                                                <label class="option-label">
                                                    <input
                                                        type="checkbox"
                                                        name="composant_{{ composant.id }}_options[]"
                                                        value="{{ option.id }}"
                                                        data-prix="{{ option.prixSupplementaire }}"
                                                    >
                                                    <span class="option-nom">{{ option.nom }}</span>
                                                </label>
                                                {% if option.prixSupplementaire > 0 %}
                                                    <span class="option-prix-payant">+ {{ option.prixSupplementaire }} €</span>
                                                {% else %}
                                                    <span class="option-prix-gratuit">Gratuit</span>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    {% endif %}

                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endfor %}

                {# Prix total mis à jour dynamiquement #}
                <div class="prix-total-block">
                    <span class="prix-total-label">Prix total</span>
                    <span class="prix-total-value" id="prix-total">{{ menu.prix|number_format(2, ',', ' ') }} €</span>
                </div>

                <button type="submit" class="btn btn-success" style="width:100%;font-size:17px;padding:14px">
                    🛒 Ajouter au panier
                </button>
            </form>

            <div style="margin-top:14px">
                <a href="{{ path('app_menu_index') }}" class="btn btn-secondary">← Retour aux menus</a>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
<script>
    const prixBase = parseFloat(document.getElementById('quantite').dataset.prix);

    function showOptions(composantId, produitId) {
        // Cacher tous les blocs options du composant
        document.querySelectorAll('[id^="options_c' + composantId + '_p"]').forEach(el => {
            el.classList.remove('visible');
            // Décocher les options cachées pour qu'elles ne soient pas envoyées
            el.querySelectorAll('input[type="checkbox"]').forEach(cb => { cb.checked = false; });
        });
        // Afficher le bon bloc
        const block = document.getElementById('options_c' + composantId + '_p' + produitId);
        if (block) block.classList.add('visible');
        updateTotal();
    }

    function updateTotal() {
        let extra = 0;
        // Sommer les prix des options cochées dans les blocs visibles
        document.querySelectorAll('.options-block.visible input[type="checkbox"]:checked').forEach(cb => {
            extra += parseFloat(cb.dataset.prix) || 0;
        });
        const qte = parseInt(document.getElementById('quantite').value) || 1;
        const total = (prixBase + extra) * qte;
        document.getElementById('prix-total').textContent = total.toFixed(2).replace('.', ',') + ' €';
    }

    // Mettre à jour le total quand on change les options
    document.getElementById('form-menu').addEventListener('change', updateTotal);

    // Initialisation
    updateTotal();
</script>
{% endblock %}
